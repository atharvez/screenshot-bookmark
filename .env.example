# Screenshot Bookmark - Environment Configuration

# Required: Your Google Gemini API key
# Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional: override the default Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Optional: Server configuration
HOST=0.0.0.0
PORT=8000

# Optional: Database and upload paths
DB_PATH=~/.screenshot-bookmark/bookmarks.db
UPLOAD_DIR=~/.screenshot-bookmark/uploads

# Optional: Set to true to use mock OCR (for testing without Tesseract)
# MOCK_OCR=false

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO